# Copy to `.env.local` to override. All variables are optional and public:
# anything prefixed with VITE_ is embedded in the client bundle, so never put secrets here.

# Seed realistic demo data the first time the app starts in a browser (true | false).
VITE_SEED_DEMO_DATA=true

# Artificial delay (milliseconds) added to every local API call. Useful for seeing
# loading states while developing. Keep at 0 for normal use.
VITE_SIMULATED_LATENCY_MS=0
